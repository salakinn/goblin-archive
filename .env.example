# Copy to .env and restart the backend. Never commit your actual API key.
GOBLIN_OPENAI_API_KEY=
GOBLIN_AI_PROVIDER=openai
# Für einen OpenAI-kompatiblen Dienst: provider=custom und dessen API-Stammverzeichnis.
# GOBLIN_AI_BASE_URL=https://anbieter.example/v1
# GOBLIN_AI_CUSTOM_API_KEY=
GOBLIN_AI_TAGGING_MODEL=gpt-5.4-nano
GOBLIN_AI_LANGUAGE_MODEL=gpt-5.4-nano
GOBLIN_AI_TRANSLATION_MODEL=gpt-5.4-mini
GOBLIN_AI_TRANSLATION_QA_MODEL=gpt-5.4-mini
GOBLIN_AI_TRANSLATION_EDITOR_MODEL=gpt-5.4
# Set current prices in USD per million tokens to enable cost estimates and budget limits.
GOBLIN_AI_TRANSLATION_INPUT_USD_PER_MILLION=0
GOBLIN_AI_TRANSLATION_OUTPUT_USD_PER_MILLION=0
# If QA/editor use differently priced models, set their rates separately.
# GOBLIN_AI_TRANSLATION_QA_INPUT_USD_PER_MILLION=
# GOBLIN_AI_TRANSLATION_QA_OUTPUT_USD_PER_MILLION=
# GOBLIN_AI_TRANSLATION_EDITOR_INPUT_USD_PER_MILLION=
# GOBLIN_AI_TRANSLATION_EDITOR_OUTPUT_USD_PER_MILLION=
GOBLIN_AI_TRANSLATION_TIMEOUT=180
GOBLIN_AI_TIMEOUT=30
GOBLIN_MAX_UPLOAD_BYTES=209715200
GOBLIN_MAX_UPLOAD_FILES=20
# Bei HTTPS setzen, damit das Sitzungs-Cookie nur verschlüsselt übertragen wird.
# GOBLIN_AUTH_SECURE_COOKIES=true
